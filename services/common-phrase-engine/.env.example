# Common Phrase Filtering Engine - Environment Variables

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=balancia
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=cpe:
REDIS_TTL=86400

# ============================================================================
# QDRANT CONFIGURATION (Vector Database)
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_WEIGHTED=posts_weighted
QDRANT_COLLECTION_MASKED=posts_masked
QDRANT_COLLECTION_FULL=posts_full
VECTOR_SIZE=1536
SEARCH_LIMIT=10

# ============================================================================
# EMBEDDING MODEL CONFIGURATION
# ============================================================================
# OpenAI Example:
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT=30000

# Alternative - Local Embedding Server:
# EMBEDDING_API_URL=http://localhost:8080
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# EMBEDDING_DIMENSIONS=768

# ============================================================================
# COMMON PHRASE THRESHOLDS
# ============================================================================
# Frequency thresholds (as decimals: 0.10 = 10%)
THRESHOLD_VERY_COMMON=0.10
THRESHOLD_COMMON=0.05
THRESHOLD_SOMEWHAT_COMMON=0.03

# Weights for embeddings (0.0 to 1.0)
WEIGHT_VERY_COMMON=0.05
WEIGHT_COMMON=0.2
WEIGHT_SOMEWHAT_COMMON=0.5
WEIGHT_UNIQUE=1.0

# Minimum substantive words to check originality
MIN_SUBSTANTIVE_WORDS=5

# Common phrase ratio thresholds
RATIO_THRESHOLD_LOW=0.2
RATIO_THRESHOLD_HIGH=0.5

# Similarity difference threshold for dual check
SIMILARITY_DIFF_THRESHOLD=0.15

# ============================================================================
# ANALYTICS JOB CONFIGURATION
# ============================================================================
# Cron schedule (default: 2 AM daily)
ANALYTICS_SCHEDULE_TIME=0 2 * * *

# How many days to look back
ANALYTICS_LOOKBACK_DAYS=30

# Batch size for processing
ANALYTICS_BATCH_SIZE=10000
